# Local development: sign in with the official Databricks CLI first.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=gpu-ops
# Copy these non-secret values from your notebook and SQL warehouse.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=gpu_ops_hackathon
DATABRICKS_SQL_WAREHOUSE_ID=
# Use the official CLI installed on PATH, or set its absolute executable path.
DATABRICKS_CLI_PATH=databricks
# Comma-separated browser origins. Keep this server local for the prototype.
FRONTEND_ORIGINS=http://localhost:4397,http://127.0.0.1:4397,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
